# Optional: existing Gemini integration also accepts API_KEY.
GEMINI_API_KEY=
# Local server port (default: 3000). Never prefix secrets with VITE_.
PORT=3000

# PostgreSQL for API-backed rides. Use a dedicated local database; never use VITE_.
DATABASE_URL=postgresql://eagleride:local_password@127.0.0.1:5432/eagleride
# Test connection must have CREATEDB permission; tests use a disposable database.
# TEST_DATABASE_URL=postgresql://eagleride:local_password@127.0.0.1:5432/postgres
